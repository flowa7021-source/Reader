<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="HostingAndDI">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <PackageVersion Include="Serilog" Version="4.2.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup Label="MvvmAndUI">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup Label="DocumentEngines">
    <PackageVersion Include="PDFiumCore" Version="146.0.7678.1" />
    <PackageVersion Include="PdfPig" Version="0.1.10" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="VersOne.Epub" Version="3.3.4" />
  </ItemGroup>

  <!-- OCR: PaddleOCR через Sdcb (in-process), 2.7-линия. Версии выровнены по реальному графу
       зависимостей Sdcb.PaddleOCR 2.7.0.3 (→ OpenCvSharp4 4.10.0.20240616 + Sdcb.PaddleInference
       2.5.0.1). Native-рантаймы совпадают с managed-версиями: PaddleInference.runtime.win64.mkl
       2.5.x под inference 2.5.x; OpenCvSharp4.runtime.win == OpenCvSharp4. 3.0-линия не берётся —
       у неё другой API загрузки моделей (не совместим с PaddleOcrEngine). -->
  <ItemGroup Label="Ocr">
    <PackageVersion Include="Sdcb.PaddleOCR" Version="2.7.0.3" />
    <PackageVersion Include="Sdcb.PaddleInference" Version="2.5.0.1" />
    <PackageVersion Include="Sdcb.PaddleInference.runtime.win64.mkl" Version="2.5.1" />
    <PackageVersion Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageVersion Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
  </ItemGroup>

  <ItemGroup Label="StorageAndSerialization">
    <!-- System.Text.Json — часть .NET 9+ runtime, явный PackageReference не нужен (NU1510). -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="DocumentConversion">
    <!-- PDF→DOCX экспорт. 3.5.1: его OpenXml.Framework тянет System.IO.Packaging 8.0.1
         (в 8.0.0 была CVE GHSA-f32c-w444-8ppv/qj66 → NU1903), поэтому не ниже 3.5.1. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup Label="Crypto">
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.5.0" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.0" />
  </ItemGroup>

  <!-- DPAPI для хранения лицензии/триала (Windows-only). Microsoft.Win32.Registry пакетом
       НЕ подключаем: на net*-windows он в framework reference (NU1510 «will not be pruned»),
       API доступен без пакета. ProtectedData — отдельный пакет (framework его не даёт). -->
  <ItemGroup Label="WindowsSecurity">
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="MEF">
    <PackageVersion Include="System.Composition" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Roslynator.Analyzers" Version="4.13.0" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="4.13.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.0" />
    <PackageVersion Include="FluentAssertions" Version="7.0.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.0.0" />
    <PackageVersion Include="Verify.Xunit" Version="28.4.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

</Project>

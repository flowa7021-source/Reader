# Force LF line endings on all platforms.
# Without this, Windows Git converts LF→CRLF on checkout, which breaks
# `dotnet format --verify-no-changes` (editorconfig requires end_of_line=lf).

* text=auto eol=lf

# Explicitly mark well-known binary types as binary to prevent corruption.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.dll binary
*.exe binary
*.pdb binary
*.nupkg binary
*.ttf binary
*.djvu binary

# Git LFS for large test assets (tests/assets/). The small synthetic PDFs generated by
# tools/gen-test-pdfs are committed as ordinary git blobs (well under 100 KB), so we do NOT
# LFS-track *.pdf broadly — that would turn them into pointers a checkout without git-lfs
# cannot smudge. Only the large binary types we are not committing now are LFS-tracked here;
# large sourced scans can opt in explicitly when added.
tests/assets/**.djvu filter=lfs diff=lfs merge=lfs -text

# Force LF line endings on all platforms.
# Without this, Windows Git converts LF→CRLF on checkout, which breaks
# `dotnet format --verify-no-changes` (editorconfig requires end_of_line=lf).

* text=auto eol=lf

# Explicitly mark well-known binary types as binary to prevent corruption.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.dll binary
*.exe binary
*.pdb binary
*.nupkg binary
*.ttf binary
*.djvu binary

# Git LFS for large test assets (tests/assets/). The small synthetic PDFs generated by
# tools/gen-test-pdfs are committed as ordinary git blobs (well under 100 KB), so we do NOT
# LFS-track *.pdf broadly — that would turn them into pointers a checkout without git-lfs
# cannot smudge. Only the large binary types we are not committing now are LFS-tracked here;
# large sourced scans can opt in explicitly when added.
tests/assets/**.djvu filter=lfs diff=lfs merge=lfs -text

# Append-only logs use git's built-in `union` merge driver: when two branches each add
# entries to the same section (typically `[Unreleased]`), the merge/rebase keeps BOTH
# sides instead of raising a conflict. Parallel feature PRs all append here, so without
# this every second PR needed a manual rebase just to resolve CHANGELOG. `union` is native
# to git (no local config / external program required), so it also applies during rebase.
# Trade-off: ordering within the section is not curated automatically — that's reconciled
# by hand at release time when `[Unreleased]` is rolled into a version section.
CHANGELOG.md merge=union

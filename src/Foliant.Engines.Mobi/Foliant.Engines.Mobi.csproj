<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Foliant.Engines.Mobi</RootNamespace>
    <Description>MOBI engine. Читает PalmDB-контейнер + PalmDOC-сжатый текст (in-box LZ77 разжиматель, без NuGet-зависимостей). Текстовые записи склеиваются в один HTML-поток, разбиваются на главы по mbp:pagebreak-маркерам и отрисовываются в реальные BGRA32-страницы через Foliant.Rendering.Html (AngleSharp + SixLabors) с fixed-reference, scale-invariant пагинацией. Text-layer несёт plain-text глав для поиска/FTS.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foliant.Domain\Foliant.Domain.csproj" />
    <ProjectReference Include="..\Foliant.Rendering.Html\Foliant.Rendering.Html.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Foliant.Engines.Mobi.Tests" />
  </ItemGroup>

</Project>

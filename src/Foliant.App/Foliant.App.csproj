<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Foliant.App</RootNamespace>
    <AssemblyName>Foliant</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Foliant.App.Program</StartupObject>
    <Description>Composition root: DI, Serilog, MainWindow.</Description>
  </PropertyGroup>

  <!-- Брендинг: иконка приложения и инсталлятора (один источник — installer/installer-assets).
       Подключаем только если файл присутствует, чтобы отсутствие ассета не ломало сборку. -->
  <PropertyGroup Condition="Exists('..\..\installer\installer-assets\foliant.ico')">
    <ApplicationIcon>..\..\installer\installer-assets\foliant.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foliant.Application\Foliant.Application.csproj" />
    <ProjectReference Include="..\Foliant.Domain\Foliant.Domain.csproj" />
    <ProjectReference Include="..\Foliant.Engines.Pdf\Foliant.Engines.Pdf.csproj" />
    <ProjectReference Include="..\Foliant.Engines.Image\Foliant.Engines.Image.csproj" />
    <ProjectReference Include="..\Foliant.Engines.Epub\Foliant.Engines.Epub.csproj" />
    <ProjectReference Include="..\Foliant.Engines.Fb2\Foliant.Engines.Fb2.csproj" />
    <ProjectReference Include="..\Foliant.Engines.Mobi\Foliant.Engines.Mobi.csproj" />
    <ProjectReference Include="..\Foliant.Engines.Ocr\Foliant.Engines.Ocr.csproj" />
    <ProjectReference Include="..\Foliant.Rendering.Html\Foliant.Rendering.Html.csproj" />
    <ProjectReference Include="..\Foliant.Infrastructure\Foliant.Infrastructure.csproj" />
    <ProjectReference Include="..\Foliant.Plugins.Contracts\Foliant.Plugins.Contracts.csproj" />
    <ProjectReference Include="..\Foliant.UI\Foliant.UI.csproj" />
    <ProjectReference Include="..\Foliant.ViewModels\Foliant.ViewModels.csproj" />
  </ItemGroup>

  <!-- Engine-плагины строятся как зависимость, но НЕ compile-time ссылка
       (ReferenceOutputAssembly=false) — обнаруживаются в рантайме PluginCatalog'ом (MEF2).
       DLL копируется в <appdir>/plugins/, откуда её сканирует AppPaths.Plugins. -->
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\Foliant.Plugin.DjVu\Foliant.Plugin.DjVu.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <Target Name="CopyEnginePlugins" AfterTargets="Build">
    <ItemGroup>
      <_DjvuPluginDll Include="..\..\plugins\Foliant.Plugin.DjVu\bin\$(Configuration)\$(TargetFramework)\Foliant.Plugin.DjVu.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_DjvuPluginDll)"
          DestinationFolder="$(OutDir)plugins"
          SkipUnchangedFiles="true"
          Condition="Exists('@(_DjvuPluginDll)')" />
  </Target>

  <!-- То же для `dotnet publish`: плагин обязан попасть в publish/plugins/, иначе инсталлятор
       уедет без DjVu. На publish с -r <rid> вывод плагина лежит в bin/<cfg>/net10.0-windows/<rid>/,
       на обычной сборке — в bin/<cfg>/net10.0-windows/. Берём RID-вариант, иначе не-RID; если нет
       ни одного — намеренно валим publish (тихо shipнуть без плагина нельзя). -->
  <Target Name="CopyEnginePluginsOnPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_DjvuPluginBin>..\..\plugins\Foliant.Plugin.DjVu\bin\$(Configuration)\net10.0-windows</_DjvuPluginBin>
    </PropertyGroup>
    <ItemGroup>
      <_DjvuPublishDll Include="$(_DjvuPluginBin)\$(RuntimeIdentifier)\Foliant.Plugin.DjVu.dll"
                       Condition="'$(RuntimeIdentifier)' != '' and Exists('$(_DjvuPluginBin)\$(RuntimeIdentifier)\Foliant.Plugin.DjVu.dll')" />
      <_DjvuPublishDll Include="$(_DjvuPluginBin)\Foliant.Plugin.DjVu.dll"
                       Condition="'@(_DjvuPublishDll)' == '' and Exists('$(_DjvuPluginBin)\Foliant.Plugin.DjVu.dll')" />
    </ItemGroup>
    <Error Condition="'@(_DjvuPublishDll)' == ''"
           Text="DjVu plugin DLL not found under $(_DjvuPluginBin) (rid='$(RuntimeIdentifier)') — refusing to publish an installer without the DjVu plugin." />
    <Copy SourceFiles="@(_DjvuPublishDll)"
          DestinationFolder="$(PublishDir)plugins"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Pro-проекты подключаются опционально, если присутствует submodule pro/ -->
  <ItemGroup Condition="Exists('..\..\pro')">
    <ProjectReference Include="..\..\pro\Foliant.Pro.AdvancedEditor\Foliant.Pro.AdvancedEditor.csproj"
                      Condition="Exists('..\..\pro\Foliant.Pro.AdvancedEditor\Foliant.Pro.AdvancedEditor.csproj')" />
  </ItemGroup>

</Project>

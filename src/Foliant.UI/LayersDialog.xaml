<Window x:Class="Foliant.UI.LayersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LayersDialogTitle]}"
        Width="460"
        Height="420"
        MinWidth="360"
        MinHeight="280"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Empty-state hint: shown when the document has no OCG layers. Visibility is driven by
         the EmptyHintVisibility code-behind property — there is no inverse Boolean→Visibility
         converter declared at app-scope and shadowing the dialog with its own would duplicate it. -->
    <TextBlock Grid.Row="0"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               TextWrapping="Wrap"
               TextAlignment="Center"
               Opacity="0.75"
               Foreground="{DynamicResource Foreground}"
               Visibility="{Binding EmptyHintVisibility}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LayersEmpty]}" />

    <!-- Layer list: one checkbox per OCG, two-way bound on IsVisible. -->
    <ScrollViewer Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding ListVisibility}">
      <ItemsControl ItemsSource="{Binding Layers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox Margin="0,4"
                      Foreground="{DynamicResource Foreground}"
                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                      Content="{Binding LayerName}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Save / Close — Save disabled when there are no layers (nothing to write). -->
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LayersSaveButton]}"
              MinWidth="160" Margin="0,0,8,0"
              IsDefault="True"
              IsEnabled="{Binding HasLayers}"
              Click="OnSaveClick" />
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LayersCancelButton]}"
              MinWidth="100"
              IsCancel="True"
              Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>

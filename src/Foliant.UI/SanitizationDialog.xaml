<Window x:Class="Foliant.UI.SanitizationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SanitizeDialogTitle]}"
        SizeToContent="Height"
        Width="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="SummaryText" Grid.Row="0"
               TextWrapping="Wrap"
               Foreground="{DynamicResource Foreground}" />

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button x:Name="RemoveButton"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SanitizeRemoveButton]}"
              Width="160" Margin="0,0,8,0"
              IsDefault="True"
              Click="OnRemoveClick" />
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SanitizeCloseButton]}"
              Width="80"
              IsCancel="True"
              Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>

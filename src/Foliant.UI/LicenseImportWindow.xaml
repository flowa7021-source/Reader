<Window x:Class="Foliant.UI.LicenseImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LicenseImportTitle]}"
        Width="540"
        Height="460"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Margin="0,0,0,4"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LicenseImportJsonLabel]}" />
    <TextBox Grid.Row="1"
             Margin="0,0,0,8"
             AcceptsReturn="True"
             AcceptsTab="False"
             FontFamily="Consolas"
             VerticalScrollBarVisibility="Auto"
             TextWrapping="Wrap"
             Text="{Binding LicenseJson, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Grid.Row="2"
               Margin="0,0,0,4"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LicenseImportSignatureLabel]}" />
    <TextBox Grid.Row="3"
             Margin="0,0,0,8"
             AcceptsReturn="True"
             AcceptsTab="False"
             FontFamily="Consolas"
             VerticalScrollBarVisibility="Auto"
             TextWrapping="Wrap"
             Text="{Binding SignatureBase64, UpdateSourceTrigger=PropertyChanged}" />

    <StackPanel Grid.Row="4"
                Margin="0,0,0,8">
      <TextBlock Foreground="Red"
                 TextWrapping="Wrap"
                 Text="{Binding ErrorMessage}" />
      <TextBlock Foreground="{DynamicResource Foreground}"
                 TextWrapping="Wrap"
                 Text="{Binding LastResult.Status, StringFormat='Status: {0}'}" />
    </StackPanel>

    <StackPanel Grid.Row="5"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Width="96"
              Margin="0,0,8,0"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LicenseImportButton]}"
              Command="{Binding ImportCommand}"
              IsDefault="True" />
      <Button Width="96"
              Margin="0,0,8,0"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LicenseClearButton]}"
              Command="{Binding ClearCommand}" />
      <Button Width="96"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LicenseCloseButton]}"
              IsCancel="True"
              Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>

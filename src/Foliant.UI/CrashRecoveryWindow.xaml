<Window x:Class="Foliant.UI.CrashRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CrashRecoveryTitle]}"
        Width="480"
        Height="360"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               TextWrapping="Wrap"
               Margin="0,0,0,8"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CrashRecoveryHeader]}" />

    <ListBox Grid.Row="1"
             ItemsSource="{Binding PendingDocuments}"
             Background="Transparent"
             BorderThickness="0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Binding Fingerprint}"
                         FontFamily="Consolas"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource Foreground}" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding EventCount}"
                           Margin="0,0,4,0"
                           Foreground="{DynamicResource Foreground}" />
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CrashRecoveryActions]}"
                           Foreground="{DynamicResource Foreground}" />
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CrashRecoveryDismiss]}"
                    Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button MinWidth="110"
              Margin="0,0,8,0"
              Padding="10,4"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CrashRecoveryDismissAll]}"
              Command="{Binding DismissAllCommand}" />
      <Button MinWidth="90"
              Padding="10,4"
              IsCancel="True"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CrashRecoveryClose]}" />
    </StackPanel>
  </Grid>
</Window>

<Window x:Class="Foliant.UI.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PasswordPromptTitle]}"
        SizeToContent="Height"
        Width="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Message: file name + base hint. Set from code-behind (PromptMessage) so the file
         name can be interpolated; not a static localization binding. -->
    <TextBlock Grid.Row="0"
               Margin="0,0,0,8"
               Foreground="{DynamicResource Foreground}"
               TextWrapping="Wrap"
               Text="{Binding PromptMessage}" />

    <!-- Retry banner: visible only after a wrong password (IsRetry → RetryVisibility). The
         password is masked, so we cannot pre-fill; the user simply re-enters. -->
    <TextBlock Grid.Row="1"
               Margin="0,0,0,8"
               Foreground="{DynamicResource Foreground}"
               Opacity="0.85"
               TextWrapping="Wrap"
               Visibility="{Binding RetryVisibility}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PasswordPromptRetry]}" />

    <!-- PasswordBox masks input by design and is NOT data-bindable — we read .Password in the
         OK handler code-behind. x:Name lets the handler reach it. -->
    <PasswordBox x:Name="PasswordInput"
                 Grid.Row="2"
                 FontSize="14"
                 Padding="4" />

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PasswordPromptOk]}"
              Width="90"
              Margin="0,0,8,0"
              IsDefault="True"
              Click="OnOkClick" />
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DialogCancel]}"
              Width="80"
              IsCancel="True"
              Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>

<Window x:Class="Foliant.UI.WatermarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[WatermarkDialogTitle]}"
        SizeToContent="Height"
        Width="440"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="140" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="56" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[WatermarkText]}" />
    <TextBox x:Name="TextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
             Margin="0,4" Padding="4"
             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[WatermarkFontSize]}" />
    <Slider Grid.Row="1" Grid.Column="1" Margin="0,4"
            Minimum="8" Maximum="144" SmallChange="1" LargeChange="8"
            Value="{Binding SpecFontSize, Mode=TwoWay}" />
    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding SpecFontSize, StringFormat={}{0:0} pt}" />

    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[WatermarkOpacity]}" />
    <Slider Grid.Row="2" Grid.Column="1" Margin="0,4"
            Minimum="0.05" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
            Value="{Binding SpecOpacity, Mode=TwoWay}" />
    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding SpecOpacity, StringFormat={}{0:P0}}" />

    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[WatermarkAngle]}" />
    <Slider Grid.Row="3" Grid.Column="1" Margin="0,4"
            Minimum="-90" Maximum="90" SmallChange="1" LargeChange="15"
            Value="{Binding Angle, Mode=TwoWay}" />
    <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Angle, StringFormat={}{0:0}°}" />

    <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[WatermarkColorR]}" />
    <Slider Grid.Row="4" Grid.Column="1" Margin="0,4"
            Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
            Value="{Binding R, Mode=TwoWay}" />
    <TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding R, StringFormat={}{0:0}}" />

    <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[WatermarkColorG]}" />
    <Slider Grid.Row="5" Grid.Column="1" Margin="0,4"
            Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
            Value="{Binding G, Mode=TwoWay}" />
    <TextBlock Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding G, StringFormat={}{0:0}}" />

    <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[WatermarkColorB]}" />
    <Slider Grid.Row="6" Grid.Column="1" Margin="0,4"
            Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
            Value="{Binding B, Mode=TwoWay}" />
    <TextBlock Grid.Row="6" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding B, StringFormat={}{0:0}}" />

    <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PageRangeLabel]}" />
    <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
             Margin="0,4" Padding="4"
             ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PageRangeHint]}"
             Text="{Binding PageRangeText, UpdateSourceTrigger=PropertyChanged}" />

    <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[WatermarkImageLabel]}" />
    <DockPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
               Margin="0,4" LastChildFill="True">
      <Button DockPanel.Dock="Right" Padding="8,2" Margin="4,0,0,0"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[WatermarkImageBrowse]}"
              Click="OnBrowseImageClick" />
      <TextBox VerticalContentAlignment="Center" Padding="4"
               ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[WatermarkImageHint]}"
               Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" />
    </DockPanel>

    <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DialogOk]}"
              Width="80" Margin="0,0,8,0"
              IsDefault="True"
              IsEnabled="{Binding IsValid}"
              Click="OnOkClick" />
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DialogCancel]}"
              Width="80"
              IsCancel="True"
              Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>

<Window x:Class="Foliant.UI.ViewerPreferencesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsDialogTitle]}"
        SizeToContent="Height"
        Width="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Page layout -->
    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsPageLayoutLabel]}" />
    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4"
              SelectedIndex="{Binding PageLayoutIndex, Mode=TwoWay}">
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsLayoutDefault]}" />
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsLayoutSinglePage]}" />
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsLayoutOneColumn]}" />
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsLayoutTwoColumnLeft]}" />
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsLayoutTwoColumnRight]}" />
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsLayoutTwoPageLeft]}" />
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsLayoutTwoPageRight]}" />
    </ComboBox>

    <!-- Page mode (navigation panel) -->
    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsPageModeLabel]}" />
    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4"
              SelectedIndex="{Binding PageModeIndex, Mode=TwoWay}">
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsModeDefault]}" />
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsModeUseNone]}" />
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsModeUseOutlines]}" />
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsModeUseThumbs]}" />
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsModeFullScreen]}" />
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsModeUseOC]}" />
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsModeUseAttachments]}" />
    </ComboBox>

    <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
              Foreground="{DynamicResource Foreground}"
              IsChecked="{Binding HideToolbar, Mode=TwoWay}"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsHideToolbar]}" />
    <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0"
              Foreground="{DynamicResource Foreground}"
              IsChecked="{Binding HideMenubar, Mode=TwoWay}"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsHideMenubar]}" />
    <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0"
              Foreground="{DynamicResource Foreground}"
              IsChecked="{Binding FitWindow, Mode=TwoWay}"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsFitWindow]}" />
    <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0"
              Foreground="{DynamicResource Foreground}"
              IsChecked="{Binding CenterWindow, Mode=TwoWay}"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsCenterWindow]}" />
    <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0"
              Foreground="{DynamicResource Foreground}"
              IsChecked="{Binding DisplayDocTitle, Mode=TwoWay}"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsDisplayDocTitle]}" />

    <!-- Save As / Cancel -->
    <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsSaveButton]}"
              Width="120" Margin="0,0,8,0"
              IsDefault="True"
              Click="OnSaveClick" />
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ViewerPrefsCancelButton]}"
              Width="80"
              IsCancel="True"
              Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>

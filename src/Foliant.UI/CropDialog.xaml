<Window x:Class="Foliant.UI.CropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CropDialogTitle]}"
        SizeToContent="Height"
        Width="460"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="140" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="56" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Margin="0,0,0,8"
               TextWrapping="Wrap"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CropDialogHint]}" />

    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CropLeft]}" />
    <Slider Grid.Row="1" Grid.Column="1" Margin="0,4"
            Minimum="0" Maximum="0.5" SmallChange="0.01" LargeChange="0.05"
            Value="{Binding TrimLeft, Mode=TwoWay}" />
    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding TrimLeft, StringFormat={}{0:P0}}" />

    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CropTop]}" />
    <Slider Grid.Row="2" Grid.Column="1" Margin="0,4"
            Minimum="0" Maximum="0.5" SmallChange="0.01" LargeChange="0.05"
            Value="{Binding TrimTop, Mode=TwoWay}" />
    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding TrimTop, StringFormat={}{0:P0}}" />

    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CropRight]}" />
    <Slider Grid.Row="3" Grid.Column="1" Margin="0,4"
            Minimum="0" Maximum="0.5" SmallChange="0.01" LargeChange="0.05"
            Value="{Binding TrimRight, Mode=TwoWay}" />
    <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding TrimRight, StringFormat={}{0:P0}}" />

    <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CropBottom]}" />
    <Slider Grid.Row="4" Grid.Column="1" Margin="0,4"
            Minimum="0" Maximum="0.5" SmallChange="0.01" LargeChange="0.05"
            Value="{Binding TrimBottom, Mode=TwoWay}" />
    <TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding TrimBottom, StringFormat={}{0:P0}}" />

    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DialogOk]}"
              Width="80" Margin="0,0,8,0"
              IsDefault="True"
              IsEnabled="{Binding IsValid}"
              Click="OnOkClick" />
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DialogCancel]}"
              Width="80"
              IsCancel="True"
              Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>

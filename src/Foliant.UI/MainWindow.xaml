<Window x:Class="Foliant.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Foliant.ViewModels;assembly=Foliant.ViewModels"
        xmlns:ui="clr-namespace:Foliant.UI.Controls"
        xmlns:converters="clr-namespace:Foliant.UI.Converters"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Title}"
        Width="1280"
        Height="800"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterScreen"
        Loaded="OnWindowLoaded">

  <Window.Resources>
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <converters:AnnotationMetadataLineConverter x:Key="AnnotationMetadataLineConverter" />
    <converters:DepthToIndentConverter x:Key="DepthToIndentConverter" />
    <converters:OneBasedPageConverter x:Key="OneBasedPageConverter" />
    <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
    <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="Escape"
                Command="{Binding SelectedTab.ClearToolCommand}" />
    <KeyBinding Key="F"
                Modifiers="Control"
                Command="{Binding SelectedTab.ToggleSearchCommand}" />
    <KeyBinding Key="F3"
                Command="{Binding SelectedTab.NextSearchHitCommand}" />
    <KeyBinding Key="F3"
                Modifiers="Shift"
                Command="{Binding SelectedTab.PreviousSearchHitCommand}" />
    <KeyBinding Key="Left"
                Modifiers="Alt"
                Command="{Binding SelectedTab.GoBackCommand}" />
    <KeyBinding Key="Right"
                Modifiers="Alt"
                Command="{Binding SelectedTab.GoForwardCommand}" />
    <KeyBinding Key="D"
                Modifiers="Control"
                Command="{Binding SelectedTab.ToggleBookmarkCommand}" />
    <KeyBinding Key="F2"
                Command="{Binding SelectedTab.NextBookmarkCommand}" />
    <KeyBinding Key="F2"
                Modifiers="Shift"
                Command="{Binding SelectedTab.PreviousBookmarkCommand}" />
    <KeyBinding Key="Tab"
                Modifiers="Control"
                Command="{Binding NextTabCommand}" />
    <KeyBinding Key="Tab"
                Modifiers="Control+Shift"
                Command="{Binding PreviousTabCommand}" />
    <KeyBinding Key="W"
                Modifiers="Control"
                Command="{Binding CloseCurrentTabCommand}" />
    <KeyBinding Key="D1"
                Modifiers="Control"
                Command="{Binding SelectTabByNumberCommand}"
                CommandParameter="1" />
    <KeyBinding Key="D2"
                Modifiers="Control"
                Command="{Binding SelectTabByNumberCommand}"
                CommandParameter="2" />
    <KeyBinding Key="D3"
                Modifiers="Control"
                Command="{Binding SelectTabByNumberCommand}"
                CommandParameter="3" />
    <KeyBinding Key="D4"
                Modifiers="Control"
                Command="{Binding SelectTabByNumberCommand}"
                CommandParameter="4" />
    <KeyBinding Key="D5"
                Modifiers="Control"
                Command="{Binding SelectTabByNumberCommand}"
                CommandParameter="5" />
    <KeyBinding Key="D6"
                Modifiers="Control"
                Command="{Binding SelectTabByNumberCommand}"
                CommandParameter="6" />
    <KeyBinding Key="D7"
                Modifiers="Control"
                Command="{Binding SelectTabByNumberCommand}"
                CommandParameter="7" />
    <KeyBinding Key="D8"
                Modifiers="Control"
                Command="{Binding SelectTabByNumberCommand}"
                CommandParameter="8" />
    <KeyBinding Key="D9"
                Modifiers="Control"
                Command="{Binding SelectTabByNumberCommand}"
                CommandParameter="9" />
    <KeyBinding Key="PageDown"
                Command="{Binding SelectedTab.NextPageCommand}" />
    <KeyBinding Key="PageUp"
                Command="{Binding SelectedTab.PreviousPageCommand}" />
    <KeyBinding Key="Home"
                Modifiers="Control"
                Command="{Binding SelectedTab.FirstPageCommand}" />
    <KeyBinding Key="End"
                Modifiers="Control"
                Command="{Binding SelectedTab.LastPageCommand}" />
    <KeyBinding Key="OemPlus"
                Modifiers="Control"
                Command="{Binding SelectedTab.ZoomInCommand}" />
    <KeyBinding Key="Add"
                Modifiers="Control"
                Command="{Binding SelectedTab.ZoomInCommand}" />
    <KeyBinding Key="OemMinus"
                Modifiers="Control"
                Command="{Binding SelectedTab.ZoomOutCommand}" />
    <KeyBinding Key="Subtract"
                Modifiers="Control"
                Command="{Binding SelectedTab.ZoomOutCommand}" />
    <KeyBinding Key="D0"
                Modifiers="Control"
                Command="{Binding SelectedTab.ResetZoomCommand}" />
    <KeyBinding Key="NumPad0"
                Modifiers="Control"
                Command="{Binding SelectedTab.ResetZoomCommand}" />
    <KeyBinding Key="P"
                Modifiers="Control"
                Command="{Binding SelectedTab.PrintCommand}" />
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Banners (trial + update) -->
    <StackPanel Grid.Row="0">
      <Border Background="#FFF3CD"
              Padding="8,4"
              Visibility="{Binding IsTrialBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock Text="{Binding TrialMessage}"
                   HorizontalAlignment="Center"
                   Foreground="#664D03" />
      </Border>
      <Border Background="#CFE2FF"
              Padding="8,4"
              Visibility="{Binding UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock Text="{Binding UpdateMessage}"
                   HorizontalAlignment="Center"
                   Foreground="#084298" />
      </Border>
    </StackPanel>

    <!-- Menu -->
    <Menu Grid.Row="1">
      <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFile]}">
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileOpen]}"
                  Click="OnOpenMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileOpenRecent]}"
                  ItemsSource="{Binding RecentFiles}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem">
              <Setter Property="Header"
                      Value="{Binding}" />
              <Setter Property="Command"
                      Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Setter Property="CommandParameter"
                      Value="{Binding}" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileClearRecent]}"
                  Command="{Binding ClearRecentsCommand}" />
        <Separator />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileExportAnnotatedPdf]}"
                  IsEnabled="{Binding SelectedTab.CanExportAnnotatedPdf, FallbackValue=False}"
                  Click="OnExportAnnotatedPdfMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileExportPageImage]}"
                  IsEnabled="{Binding SelectedTab.CanExportCurrentPageAsImage, FallbackValue=False}"
                  Click="OnExportPageImageMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileExportAllPagesAsImages]}"
                  IsEnabled="{Binding SelectedTab.CanExportAllPagesAsImages, FallbackValue=False}"
                  Click="OnExportAllPagesAsImagesMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileExportBookmarks]}"
                  IsEnabled="{Binding SelectedTab.CanExportBookmarks, FallbackValue=False}"
                  Click="OnExportBookmarksMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileExportBookmarksToPdf]}"
                  IsEnabled="{Binding SelectedTab.CanExportBookmarksToPdf, FallbackValue=False}"
                  Click="OnExportBookmarksToPdfMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileImportBookmarks]}"
                  IsEnabled="{Binding SelectedTab.CanImportBookmarks, FallbackValue=False}"
                  Click="OnImportBookmarksMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileImportPdfOutline]}"
                  IsEnabled="{Binding SelectedTab.CanImportPdfOutline, FallbackValue=False}"
                  Command="{Binding SelectedTab.ImportPdfOutlineCommand}" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileExportFormData]}"
                  IsEnabled="{Binding SelectedTab.CanExportFormData, FallbackValue=False}"
                  Click="OnExportFormDataMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileImportFormData]}"
                  IsEnabled="{Binding SelectedTab.CanImportFormData, FallbackValue=False}"
                  Click="OnImportFormDataMenuItemClick" />
        <Separator />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileMergePdfs]}"
                  IsEnabled="{Binding CanMergePdfs, FallbackValue=False}"
                  Click="OnMergePdfsMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileSplitEvery]}"
                  IsEnabled="{Binding SelectedTab.CanSplitPdf, FallbackValue=False}"
                  Click="OnSplitEveryMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileExtractSelection]}"
                  IsEnabled="{Binding SelectedTab.CanSplitPdf, FallbackValue=False}"
                  Click="OnExtractSelectionMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileInsertPages]}"
                  IsEnabled="{Binding SelectedTab.CanInsertPages, FallbackValue=False}"
                  Click="OnInsertPagesMenuItemClick" />
        <Separator />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileAddWatermark]}"
                  IsEnabled="{Binding SelectedTab.CanAddWatermark, FallbackValue=False}"
                  Click="OnAddWatermarkMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileAddHeaderFooter]}"
                  IsEnabled="{Binding SelectedTab.CanAddHeaderFooter, FallbackValue=False}"
                  Click="OnAddHeaderFooterMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileBatesNumbering]}"
                  IsEnabled="{Binding SelectedTab.CanApplyBates, FallbackValue=False}"
                  Click="OnApplyBatesMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileCropPages]}"
                  IsEnabled="{Binding SelectedTab.CanCropPages, FallbackValue=False}"
                  Click="OnCropPagesMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileRedact]}"
                  IsEnabled="{Binding SelectedTab.CanRedactPages, FallbackValue=False}"
                  Click="OnRedactPagesMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileDocumentProperties]}"
                  IsEnabled="{Binding SelectedTab.CanEditMetadata, FallbackValue=False}"
                  Click="OnDocumentPropertiesMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileCustomProperties]}"
                  IsEnabled="{Binding SelectedTab.CanEditCustomProperties, FallbackValue=False}"
                  Click="OnCustomPropertiesMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFilePageLabels]}"
                  IsEnabled="{Binding SelectedTab.CanEditPageLabels, FallbackValue=False}"
                  Click="OnPageLabelsMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileViewerPreferences]}"
                  IsEnabled="{Binding SelectedTab.CanEditViewerPreferences, FallbackValue=False}"
                  Click="OnViewerPreferencesMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileAttachments]}"
                  IsEnabled="{Binding SelectedTab.CanManageAttachments, FallbackValue=False}"
                  Click="OnAttachmentsMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileXmp]}"
                  IsEnabled="{Binding SelectedTab.CanEditXmp, FallbackValue=False}"
                  Click="OnXmpMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileSanitize]}"
                  IsEnabled="{Binding SelectedTab.CanSanitize, FallbackValue=False}"
                  Click="OnSanitizeMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileNamedDestinations]}"
                  IsEnabled="{Binding SelectedTab.CanManageNamedDestinations, FallbackValue=False}"
                  Click="OnNamedDestinationsMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileFonts]}"
                  IsEnabled="{Binding SelectedTab.CanListFonts, FallbackValue=False}"
                  Click="OnFontsMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileLinks]}"
                  IsEnabled="{Binding SelectedTab.CanListLinks, FallbackValue=False}"
                  Click="OnLinksMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileOutline]}"
                  IsEnabled="{Binding SelectedTab.CanViewOutline, FallbackValue=False}"
                  Click="OnOutlineViewMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileOutputIntents]}"
                  IsEnabled="{Binding SelectedTab.CanListOutputIntents, FallbackValue=False}"
                  Click="OnOutputIntentsMenuItemClick" />
        <Separator />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFilePrint]}"
                  IsEnabled="{Binding SelectedTab.CanPrint, FallbackValue=False}"
                  InputGestureText="Ctrl+P"
                  Click="OnPrintMenuItemClick" />
        <Separator />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuFileExit]}"
                  Click="OnExitMenuItemClick" />
      </MenuItem>
      <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuTools]}">
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuToolsRunOcr]}"
                  Command="{Binding SelectedTab.RunOcrCommand}" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuToolsCancelOcr]}"
                  Command="{Binding SelectedTab.CancelOcrCommand}" />
        <Separator />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuToolsBatch]}"
                  Click="OnBatchMenuItemClick" />
        <Separator />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuToolsFillForm]}"
                  IsEnabled="{Binding SelectedTab.CanFillForm, FallbackValue=False}"
                  Click="OnFillFormMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuToolsViewSignatures]}"
                  IsEnabled="{Binding SelectedTab.CanViewSignatures, FallbackValue=False}"
                  Click="OnViewSignaturesMenuItemClick" />
        <Separator />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuToolsImportLicense]}"
                  Click="OnImportLicenseMenuItemClick" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuToolsSettings]}"
                  Click="OnSettingsMenuItemClick" />
      </MenuItem>
      <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuEdit]}">
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuEditRotatePage]}"
                  Command="{Binding SelectedTab.RotateCurrentPageCommand}" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuEditDeletePage]}"
                  Command="{Binding SelectedTab.DeleteCurrentPageCommand}" />
        <Separator />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuEditMovePageUp]}"
                  Command="{Binding SelectedTab.MovePageUpCommand}" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuEditMovePageDown]}"
                  Command="{Binding SelectedTab.MovePageDownCommand}" />
      </MenuItem>
      <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuView]}">
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuViewTheme]}">
          <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeLight]}"
                    Command="{Binding ChangeThemeCommand}"
                    CommandParameter="Light" />
          <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeDark]}"
                    Command="{Binding ChangeThemeCommand}"
                    CommandParameter="Dark" />
          <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeHighContrast]}"
                    Command="{Binding ChangeThemeCommand}"
                    CommandParameter="HighContrast" />
        </MenuItem>
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuViewAnnotations]}"
                  Command="{Binding SelectedTab.ToggleAnnotationsCommand}" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuViewBookmarks]}"
                  Command="{Binding SelectedTab.ToggleBookmarksCommand}" />
        <Separator />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuViewFitWidth]}"
                  Command="{Binding SelectedTab.FitWidthCommand}" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuViewFitPage]}"
                  Command="{Binding SelectedTab.FitPageCommand}" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuViewActualSize]}"
                  Command="{Binding SelectedTab.ActualSizeCommand}" />
        <Separator />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuViewSinglePage]}"
                  Command="{Binding SelectedTab.SetSinglePageViewCommand}" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuViewContinuous]}"
                  Command="{Binding SelectedTab.SetContinuousViewCommand}" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuViewTwoPage]}"
                  Command="{Binding SelectedTab.SetTwoPageViewCommand}" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuViewTwoPageCoverSeparate]}"
                  IsCheckable="True"
                  IsChecked="{Binding SelectedTab.TwoPageCoverSeparate, Mode=TwoWay}"
                  IsEnabled="{Binding SelectedTab.IsTwoPageView}" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuViewRightToLeft]}"
                  IsCheckable="True"
                  IsChecked="{Binding SelectedTab.IsRightToLeft, Mode=TwoWay}" />
        <Separator />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuViewThumbnails]}"
                  Command="{Binding SelectedTab.ToggleThumbnailStripCommand}" />
        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuViewLayers]}"
                  IsEnabled="{Binding SelectedTab.CanShowLayers, FallbackValue=False}"
                  Click="OnShowLayersMenuItemClick" />
      </MenuItem>
    </Menu>

    <!-- Tab Control -->
    <TabControl Grid.Row="2"
                ItemsSource="{Binding Tabs}"
                SelectedItem="{Binding SelectedTab}"
                Background="{DynamicResource TabBackground}">
      <TabControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Title}" />
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentTabViewModel}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Page surface (one of three layouts visible per ViewMode) -->
            <DockPanel Grid.Column="0">
              <!-- Annotation tool palette (B1b): rubber-band-rect + single-click tools.
                   Acts on the current page (single-page view); continuous/two-page wiring — B1d. -->
              <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
                <ToolBar>
                  <ToggleButton Command="{Binding SelectedTab.SelectToolCommand}"
                                CommandParameter="{x:Static vm:AnnotationTool.Highlight}"
                                IsChecked="{Binding SelectedTab.ActiveTool, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:AnnotationTool.Highlight}}"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolHighlight]}"
                                Content="H" />
                  <ToggleButton Command="{Binding SelectedTab.SelectToolCommand}"
                                CommandParameter="{x:Static vm:AnnotationTool.Underline}"
                                IsChecked="{Binding SelectedTab.ActiveTool, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:AnnotationTool.Underline}}"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolUnderline]}"
                                Content="U" />
                  <ToggleButton Command="{Binding SelectedTab.SelectToolCommand}"
                                CommandParameter="{x:Static vm:AnnotationTool.Strikethrough}"
                                IsChecked="{Binding SelectedTab.ActiveTool, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:AnnotationTool.Strikethrough}}"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolStrikethrough]}"
                                Content="S" />
                  <Separator />
                  <ToggleButton Command="{Binding SelectedTab.SelectToolCommand}"
                                CommandParameter="{x:Static vm:AnnotationTool.Rectangle}"
                                IsChecked="{Binding SelectedTab.ActiveTool, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:AnnotationTool.Rectangle}}"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolRectangle]}"
                                Content="▭" />
                  <ToggleButton Command="{Binding SelectedTab.SelectToolCommand}"
                                CommandParameter="{x:Static vm:AnnotationTool.Ellipse}"
                                IsChecked="{Binding SelectedTab.ActiveTool, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:AnnotationTool.Ellipse}}"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolEllipse]}"
                                Content="◯" />
                  <ToggleButton Command="{Binding SelectedTab.SelectToolCommand}"
                                CommandParameter="{x:Static vm:AnnotationTool.Stamp}"
                                IsChecked="{Binding SelectedTab.ActiveTool, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:AnnotationTool.Stamp}}"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolStamp]}"
                                Content="◈" />
                  <Separator />
                  <ToggleButton Command="{Binding SelectedTab.SelectToolCommand}"
                                CommandParameter="{x:Static vm:AnnotationTool.Line}"
                                IsChecked="{Binding SelectedTab.ActiveTool, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:AnnotationTool.Line}}"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolLine]}"
                                Content="／" />
                  <ToggleButton Command="{Binding SelectedTab.SelectToolCommand}"
                                CommandParameter="{x:Static vm:AnnotationTool.Arrow}"
                                IsChecked="{Binding SelectedTab.ActiveTool, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:AnnotationTool.Arrow}}"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolArrow]}"
                                Content="↗" />
                  <ToggleButton Command="{Binding SelectedTab.SelectToolCommand}"
                                CommandParameter="{x:Static vm:AnnotationTool.Freehand}"
                                IsChecked="{Binding SelectedTab.ActiveTool, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:AnnotationTool.Freehand}}"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolFreehand]}"
                                Content="✐" />
                  <ToggleButton Command="{Binding SelectedTab.SelectToolCommand}"
                                CommandParameter="{x:Static vm:AnnotationTool.Polygon}"
                                IsChecked="{Binding SelectedTab.ActiveTool, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:AnnotationTool.Polygon}}"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolPolygon]}"
                                Content="⬠" />
                  <Separator />
                  <ToggleButton Command="{Binding SelectedTab.SelectToolCommand}"
                                CommandParameter="{x:Static vm:AnnotationTool.StickyNote}"
                                IsChecked="{Binding SelectedTab.ActiveTool, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:AnnotationTool.StickyNote}}"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolStickyNote]}"
                                Content="✎" />
                </ToolBar>

                <!-- Color swatch palette (B1d): clicking sets NewAnnotationColorHex for next-
                     created annotation. IsChecked highlights the currently-selected swatch. -->
                <ToolBar ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolColorPaletteTooltip]}">
                  <ToggleButton Command="{Binding SelectedTab.SetNewAnnotationColorCommand}"
                                CommandParameter="#FFEB3B"
                                IsChecked="{Binding SelectedTab.NewAnnotationColorHex, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=#FFEB3B}"
                                Width="20" Height="20" Background="#FFEB3B" />
                  <ToggleButton Command="{Binding SelectedTab.SetNewAnnotationColorCommand}"
                                CommandParameter="#FF9800"
                                IsChecked="{Binding SelectedTab.NewAnnotationColorHex, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=#FF9800}"
                                Width="20" Height="20" Background="#FF9800" />
                  <ToggleButton Command="{Binding SelectedTab.SetNewAnnotationColorCommand}"
                                CommandParameter="#F44336"
                                IsChecked="{Binding SelectedTab.NewAnnotationColorHex, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=#F44336}"
                                Width="20" Height="20" Background="#F44336" />
                  <ToggleButton Command="{Binding SelectedTab.SetNewAnnotationColorCommand}"
                                CommandParameter="#4CAF50"
                                IsChecked="{Binding SelectedTab.NewAnnotationColorHex, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=#4CAF50}"
                                Width="20" Height="20" Background="#4CAF50" />
                  <ToggleButton Command="{Binding SelectedTab.SetNewAnnotationColorCommand}"
                                CommandParameter="#2196F3"
                                IsChecked="{Binding SelectedTab.NewAnnotationColorHex, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=#2196F3}"
                                Width="20" Height="20" Background="#2196F3" />
                  <ToggleButton Command="{Binding SelectedTab.SetNewAnnotationColorCommand}"
                                CommandParameter="#9C27B0"
                                IsChecked="{Binding SelectedTab.NewAnnotationColorHex, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=#9C27B0}"
                                Width="20" Height="20" Background="#9C27B0" />
                  <ToggleButton Command="{Binding SelectedTab.SetNewAnnotationColorCommand}"
                                CommandParameter="#000000"
                                IsChecked="{Binding SelectedTab.NewAnnotationColorHex, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=#000000}"
                                Width="20" Height="20" Background="#000000" />
                </ToolBar>

                <!-- Stamp label combo + image picker (B1d / B1e): visible only when Stamp tool is
                     active. Editable combo — preset labels or custom; Pick image… → ImageStamp
                     instead of text-stamp; Clear → revert to text. -->
                <ToolBar Visibility="{Binding SelectedTab.ActiveTool, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static vm:AnnotationTool.Stamp}, FallbackValue=Collapsed}">
                  <ComboBox Width="160"
                            IsEditable="True"
                            ItemsSource="{Binding SelectedTab.StampLabels}"
                            Text="{Binding SelectedTab.StampLabel, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolStampLabel]}" />
                  <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolStampPickImage]}"
                          ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolStampPickImageTooltip]}"
                          Click="OnPickStampImageClick" />
                  <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolStampClearImage]}"
                          ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolStampClearImageTooltip]}"
                          Command="{Binding SelectedTab.ClearStampImageCommand}"
                          Visibility="{Binding SelectedTab.HasStampImage, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                </ToolBar>
              </ToolBarTray>

              <Grid SizeChanged="OnPageAreaSizeChanged">
              <!-- Single page (with annotation + search overlay) -->
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding IsSinglePageView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Top">
                  <ui:PageSurface PageRender="{Binding CurrentRender}" />
                  <ui:AnnotationLayer PageRender="{Binding CurrentRender}"
                                      Annotations="{Binding CurrentPageAnnotations}"
                                      SearchHighlights="{Binding CurrentPageSearchHighlights}"
                                      CreateNoteCommand="{Binding AddNoteAtCommand}"
                                      ActiveTool="{Binding ActiveTool}"
                                      PageIndex="{Binding CurrentPageIndex}"
                                      CommitRectToolCommand="{Binding CommitRectToolOnPageCommand}"
                                      CommitPointToolCommand="{Binding CommitPointToolOnPageCommand}"
                                      CommitTwoPointToolCommand="{Binding CommitTwoPointToolOnPageCommand}"
                                      CommitMultiPointToolCommand="{Binding CommitMultiPointToolOnPageCommand}" />
                </Grid>
              </ScrollViewer>

              <!-- Continuous: virtualized vertical list; each page renders lazily when realized -->
              <ListBox ItemsSource="{Binding VisiblePages}"
                       Visibility="{Binding IsContinuousView, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Background="Transparent"
                       BorderThickness="0"
                       HorizontalContentAlignment="Center"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       VirtualizingStackPanel.IsVirtualizing="True">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <ContentPresenter />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Loaded="OnVisiblePageLoaded"
                          Unloaded="OnVisiblePageUnloaded">
                      <ui:PageSurface PageRender="{Binding Render}" />
                      <ui:AnnotationLayer PageRender="{Binding Render}"
                                          Annotations="{Binding Annotations}"
                                          SearchHighlights="{Binding SearchHighlights}"
                                          PageIndex="{Binding PageIndex}"
                                          ActiveTool="{Binding SelectedItem.ActiveTool, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"
                                          CommitRectToolCommand="{Binding SelectedItem.CommitRectToolOnPageCommand, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"
                                          CommitPointToolCommand="{Binding SelectedItem.CommitPointToolOnPageCommand, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"
                                          CommitTwoPointToolCommand="{Binding SelectedItem.CommitTwoPointToolOnPageCommand, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"
                                          CommitMultiPointToolCommand="{Binding SelectedItem.CommitMultiPointToolOnPageCommand, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!-- Two-page spread (current + next, side by side) -->
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding IsTwoPageView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding VisiblePages}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="4,0"
                            Loaded="OnVisiblePageLoaded"
                            Unloaded="OnVisiblePageUnloaded">
                        <ui:PageSurface PageRender="{Binding Render}" />
                        <ui:AnnotationLayer PageRender="{Binding Render}"
                                            Annotations="{Binding Annotations}"
                                            SearchHighlights="{Binding SearchHighlights}"
                                            PageIndex="{Binding PageIndex}"
                                            ActiveTool="{Binding SelectedItem.ActiveTool, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"
                                            CommitRectToolCommand="{Binding SelectedItem.CommitRectToolOnPageCommand, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"
                                            CommitPointToolCommand="{Binding SelectedItem.CommitPointToolOnPageCommand, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"
                                            CommitTwoPointToolCommand="{Binding SelectedItem.CommitTwoPointToolOnPageCommand, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"
                                            CommitMultiPointToolCommand="{Binding SelectedItem.CommitMultiPointToolOnPageCommand, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <TextBlock Text="{Binding ErrorMessage}"
                         Foreground="Red"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
              </Grid>
            </DockPanel>

            <!-- Search sidebar (Ctrl+F toggles IsSearchVisible) -->
            <Border Grid.Column="1"
                    Width="320"
                    BorderBrush="{DynamicResource Foreground}"
                    BorderThickness="1,0,0,0"
                    Background="{DynamicResource PageBackground}"
                    Visibility="{Binding IsSearchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid Margin="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Query input + button -->
                <DockPanel Grid.Row="0"
                           LastChildFill="True">
                  <Button DockPanel.Dock="Right"
                          Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SearchButton]}"
                          Width="64"
                          Margin="4,0,0,0"
                          Command="{Binding RunSearchCommand}"
                          IsDefault="True" />
                  <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                           VerticalContentAlignment="Center"
                           ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SearchPlaceholder]}" />
                </DockPanel>

                <!-- Options (match case / whole word / fold diacritics) -->
                <WrapPanel Grid.Row="1"
                           Margin="0,6,0,0"
                           Orientation="Horizontal">
                  <CheckBox Margin="0,2,12,2"
                            IsChecked="{Binding SearchMatchCase, Mode=TwoWay}"
                            Foreground="{DynamicResource Foreground}"
                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SearchMatchCase]}" />
                  <CheckBox Margin="0,2,12,2"
                            IsChecked="{Binding SearchMatchWholeWord, Mode=TwoWay}"
                            Foreground="{DynamicResource Foreground}"
                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SearchMatchWholeWord]}" />
                  <CheckBox Margin="0,2,12,2"
                            IsChecked="{Binding SearchFoldDiacritics, Mode=TwoWay}"
                            Foreground="{DynamicResource Foreground}"
                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SearchFoldDiacritics]}" />
                </WrapPanel>

                <!-- Status -->
                <TextBlock Grid.Row="2"
                           Margin="0,8,0,4"
                           Foreground="{DynamicResource Foreground}"
                           Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SearchInProgress]}"
                           Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Results -->
                <ListBox Grid.Row="3"
                         ItemsSource="{Binding SearchResults}"
                         SelectedItem="{Binding SelectedSearchHit}"
                         Background="Transparent"
                         BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Foreground}" />
                        <TextBlock Text="{Binding Snippet}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Foreground}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <!-- All-Annotations sidebar (toggled via View menu) -->
            <Border Grid.Column="2"
                    Width="320"
                    BorderBrush="{DynamicResource Foreground}"
                    BorderThickness="1,0,0,0"
                    Background="{DynamicResource PageBackground}"
                    Visibility="{Binding IsAnnotationsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid Margin="8"
                    DataContext="{Binding AnnotationsDocument}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           LastChildFill="True">
                  <Button DockPanel.Dock="Right"
                          Content="Export"
                          Width="72"
                          Margin="4,0,0,0"
                          Command="{Binding ExportAnnotationsCommand}"
                          IsEnabled="{Binding CanExport}" />
                  <TextBlock VerticalAlignment="Center"
                             FontWeight="Bold"
                             Foreground="{DynamicResource Foreground}"
                             Text="{Binding TotalCount, StringFormat='Annotations: {0}'}" />
                </DockPanel>

                <ScrollViewer Grid.Row="1"
                              Margin="0,8,0,0"
                              VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,4">
                          <TextBlock Text="{Binding OneBasedPageNumber, StringFormat='Page {0}'}"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource Foreground}" />
                          <ItemsControl Margin="8,2,0,0"
                                        ItemsSource="{Binding Annotations}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Margin="0,1"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Border}}">
                                  <StackPanel.ContextMenu>
                                    <ContextMenu>
                                      <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AnnotationContextEditSubject]}"
                                                Click="OnAnnotationEditSubjectClick"
                                                CommandParameter="{Binding}" />
                                      <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AnnotationContextDelete]}"
                                                Command="{Binding PlacementTarget.Tag.RemoveAnnotationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                CommandParameter="{Binding}" />
                                    </ContextMenu>
                                  </StackPanel.ContextMenu>
                                  <TextBlock TextWrapping="Wrap"
                                             Foreground="{DynamicResource Foreground}"
                                             Text="{Binding Text, TargetNullValue='(highlight)'}" />
                                  <!-- Метаданные (Author · Subject · Modified): отдельной мелкой строкой, скрыта если пуста. -->
                                  <TextBlock x:Name="MetadataLine"
                                             TextWrapping="Wrap"
                                             FontSize="10"
                                             Opacity="0.65"
                                             Foreground="{DynamicResource Foreground}"
                                             Text="{Binding Converter={StaticResource AnnotationMetadataLineConverter}}"
                                             Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <TextBox Grid.Row="2"
                         Margin="0,8,0,0"
                         MaxHeight="120"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         Text="{Binding ExportedText, Mode=OneWay}"
                         Visibility="{Binding ExportedText, Converter={StaticResource NullToVisibilityConverter}}" />
              </Grid>
            </Border>

            <!-- Bookmark sidebar (toggled via View → Bookmarks); click navigates, right-click deletes.
                 Depth-indented through DepthToIndentConverter so imported TOCs visually retain hierarchy. -->
            <Border Grid.Column="3"
                    Width="260"
                    BorderBrush="{DynamicResource Foreground}"
                    BorderThickness="1,0,0,0"
                    Background="{DynamicResource PageBackground}"
                    Visibility="{Binding IsBookmarksVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid Margin="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Foreground}">
                  <Run Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BookmarksSidebarHeader], Mode=OneWay}" />
                  <Run Text=": " />
                  <Run Text="{Binding BookmarksCount, Mode=OneWay}" />
                </TextBlock>

                <ScrollViewer Grid.Row="1"
                              Margin="0,8,0,0"
                              VerticalScrollBarVisibility="Auto">
                  <ItemsControl Tag="{Binding}"
                                ItemsSource="{Binding Bookmarks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="{Binding Depth, Converter={StaticResource DepthToIndentConverter}}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Background="Transparent"
                                MouseLeftButtonUp="OnBookmarkRowClicked">
                          <Border.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BookmarkContextRename]}"
                                        Click="OnBookmarkRenameClick"
                                        CommandParameter="{Binding}" />
                              <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BookmarkContextExtract]}"
                                        Click="OnBookmarkExtractClick"
                                        CommandParameter="{Binding}" />
                              <Separator />
                              <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BookmarkContextDelete]}"
                                        Command="{Binding PlacementTarget.Tag.RemoveBookmarkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        CommandParameter="{Binding}" />
                            </ContextMenu>
                          </Border.ContextMenu>
                          <TextBlock TextWrapping="Wrap"
                                     Foreground="{DynamicResource Foreground}"
                                     Margin="0,2">
                            <Run Text="{Binding PageIndex, Converter={StaticResource OneBasedPageConverter}, Mode=OneWay}"
                                 FontWeight="SemiBold" />
                            <Run Text="  " />
                            <Run Text="{Binding Label, Mode=OneWay}" />
                          </TextBlock>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

            <!-- Thumbnail strip (toggled via View menu); click navigates, image renders lazily -->
            <Border Grid.Column="4"
                    Width="168"
                    BorderBrush="{DynamicResource Foreground}"
                    BorderThickness="1,0,0,0"
                    Background="{DynamicResource PageBackground}"
                    Visibility="{Binding IsThumbnailStripVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <ListBox ItemsSource="{Binding Thumbnails.Pages}"
                       SelectedIndex="{Binding Thumbnails.SelectedPageIndex, Mode=TwoWay}"
                       Background="Transparent"
                       BorderThickness="0"
                       HorizontalContentAlignment="Stretch"
                       AllowDrop="True"
                       PreviewMouseLeftButtonDown="OnThumbnailStripPreviewMouseLeftButtonDown"
                       PreviewMouseMove="OnThumbnailStripMouseMove"
                       Drop="OnThumbnailStripDrop"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       VirtualizingStackPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="4"
                                Loaded="OnThumbnailLoaded">
                      <ui:PageSurface PageRender="{Binding Thumbnail}"
                                      HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding DisplayNumber}"
                                 HorizontalAlignment="Center"
                                 Margin="0,2,0,0"
                                 Foreground="{DynamicResource Foreground}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Grid>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>

    <!-- Status Bar -->
    <StatusBar Grid.Row="3"
               Background="{DynamicResource StatusBarBackground}">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource Foreground}" />
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding SelectedTab.OcrStatus}"
                     Foreground="{DynamicResource Foreground}"
                     Margin="0,0,16,0" />
          <TextBlock Text="{Binding SelectedTab.PageInfo}"
                     Foreground="{DynamicResource Foreground}"
                     Margin="0,0,16,0" />
          <TextBlock Text="{Binding SelectedTab.ZoomPercent, StringFormat='{}{0}%'}"
                     Foreground="{DynamicResource Foreground}" />
        </StackPanel>
      </StatusBarItem>
    </StatusBar>
  </Grid>

</Window>

<Window x:Class="Foliant.UI.RedactionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RedactionDialogTitle]}"
        SizeToContent="Height"
        Width="440"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="100" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RedactionQueryLabel]}" />
    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4"
             Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

    <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
              Foreground="{DynamicResource Foreground}"
              IsChecked="{Binding CaseSensitive, Mode=TwoWay}"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RedactionMatchCase]}" />

    <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
              Foreground="{DynamicResource Foreground}"
              IsChecked="{Binding WholeWord, Mode=TwoWay}"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RedactionWholeWord]}" />

    <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,0"
              Foreground="{DynamicResource Foreground}"
              IsChecked="{Binding UseRegex, Mode=TwoWay}"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RedactionRegex]}" />

    <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,4,0,0"
              Foreground="{DynamicResource Foreground}"
              IsChecked="{Binding FoldDiacritics, Mode=TwoWay}"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RedactionFoldDiacritics]}" />

    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RedactionOkButton]}"
              Width="100" Margin="0,0,8,0"
              IsDefault="True"
              IsEnabled="{Binding IsValid}"
              Click="OnOkClick" />
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RedactionCancelButton]}"
              Width="80"
              IsCancel="True"
              Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>

<Window x:Class="Foliant.UI.OutlineExportOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[OutlineExportDialogTitle]}"
        SizeToContent="Height"
        Width="460"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="160" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Destination zoom mode -->
    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[OutlineExportDestLabel]}" />
    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4"
              SelectedIndex="{Binding DestinationIndex, Mode=TwoWay}">
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[OutlineDestFitPage]}" />
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[OutlineDestFitWidth]}" />
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[OutlineDestFitHeight]}" />
      <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[OutlineDestInheritZoom]}" />
    </ComboBox>

    <!-- Collapse nested -->
    <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
              Foreground="{DynamicResource Foreground}"
              IsChecked="{Binding CollapseNested, Mode=TwoWay}"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[OutlineExportCollapse]}" />

    <!-- Bold top-level -->
    <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"
              Foreground="{DynamicResource Foreground}"
              IsChecked="{Binding BoldTopLevel, Mode=TwoWay}"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[OutlineExportBoldTop]}" />

    <!-- Export / Cancel -->
    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[OutlineExportButton]}"
              Width="120" Margin="0,0,8,0"
              IsDefault="True"
              Click="OnExportClick" />
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[OutlineExportCancelButton]}"
              Width="80"
              IsCancel="True"
              Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>

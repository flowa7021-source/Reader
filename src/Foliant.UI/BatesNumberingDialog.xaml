<Window x:Class="Foliant.UI.BatesNumberingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatesDialogTitle]}"
        SizeToContent="Height"
        Width="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Row="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="56" />
      </Grid.ColumnDefinitions>

      <!-- Prefix -->
      <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatesPrefixLabel]}" />
      <TextBox x:Name="PrefixBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" Padding="4"
               Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" />

      <!-- Suffix -->
      <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatesSuffixLabel]}" />
      <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" Padding="4"
               Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" />

      <!-- Start number -->
      <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatesStartNumberLabel]}" />
      <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" Padding="4"
               Text="{Binding StartNumberText, UpdateSourceTrigger=PropertyChanged}" />

      <!-- Digits -->
      <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatesDigitsLabel]}" />
      <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" Padding="4"
               Text="{Binding DigitsText, UpdateSourceTrigger=PropertyChanged}" />

      <!-- Position -->
      <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatesPositionLabel]}" />
      <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                SelectedIndex="{Binding PositionIndex, Mode=TwoWay}">
        <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatesPositionBottomLeft]}" />
        <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatesPositionBottomCenter]}" />
        <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatesPositionBottomRight]}" />
      </ComboBox>

      <!-- Font size -->
      <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatesFontSizeLabel]}" />
      <Slider Grid.Row="5" Grid.Column="1" Margin="0,4"
              Minimum="6" Maximum="24" SmallChange="1" LargeChange="2"
              Value="{Binding StampFontSize, Mode=TwoWay}" />
      <TextBlock Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding StampFontSize, StringFormat={}{0:0} pt}" />

      <!-- Color R/G/B -->
      <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[WatermarkColorR]}" />
      <Slider Grid.Row="6" Grid.Column="1" Margin="0,4"
              Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
              Value="{Binding R, Mode=TwoWay}" />
      <TextBlock Grid.Row="6" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding R, StringFormat={}{0:0}}" />

      <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[WatermarkColorG]}" />
      <Slider Grid.Row="7" Grid.Column="1" Margin="0,4"
              Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
              Value="{Binding G, Mode=TwoWay}" />
      <TextBlock Grid.Row="7" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding G, StringFormat={}{0:0}}" />

      <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[WatermarkColorB]}" />
      <Slider Grid.Row="8" Grid.Column="1" Margin="0,4"
              Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
              Value="{Binding B, Mode=TwoWay}" />
      <TextBlock Grid.Row="8" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding B, StringFormat={}{0:0}}" />

      <!-- Page range -->
      <TextBlock Grid.Row="9" Grid.Column="0" VerticalAlignment="Center"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatesPageRangeLabel]}" />
      <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" Padding="4"
               ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PageRangeHint]}"
               Text="{Binding PageRangeText, UpdateSourceTrigger=PropertyChanged}" />

      <!-- OK / Cancel -->
      <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,16,0,0">
        <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatesOkButton]}"
                Width="80" Margin="0,0,8,0"
                IsDefault="True"
                IsEnabled="{Binding IsValid}"
                Click="OnOkClick" />
        <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatesCancelButton]}"
                Width="80"
                IsCancel="True"
                Click="OnCancelClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>

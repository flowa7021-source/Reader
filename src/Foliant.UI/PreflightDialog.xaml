<Window x:Class="Foliant.UI.PreflightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PreflightDialogTitle]}"
        SizeToContent="Height"
        Width="600"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" BorderBrush="{DynamicResource Foreground}" BorderThickness="1">
      <ListBox x:Name="FindingsList" Height="300" Background="Transparent"
               Foreground="{DynamicResource Foreground}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Margin="2" Foreground="{DynamicResource Foreground}" Text="{Binding}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PreflightCloseButton]}"
              Width="80"
              IsCancel="True"
              IsDefault="True"
              Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>

<Window x:Class="Foliant.UI.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        xmlns:vm="clr-namespace:Foliant.ViewModels;assembly=Foliant.ViewModels"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatchWindowTitle]}"
        Width="720"
        Height="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Operation selector + configure button -->
    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatchOperationLabel]}" />
      <Button DockPanel.Dock="Right"
              Margin="8,0,0,0" Padding="8,2"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatchConfigure]}"
              Click="OnConfigureClick" />
      <ComboBox Margin="8,0,0,0"
                SelectedValue="{Binding Operation, Mode=TwoWay}"
                SelectedValuePath="Tag">
        <ComboBoxItem Tag="{x:Static vm:BatchOperationKind.Watermark}"
                      Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatchOpWatermark]}" />
        <ComboBoxItem Tag="{x:Static vm:BatchOperationKind.HeaderFooter}"
                      Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatchOpHeaderFooter]}" />
        <ComboBoxItem Tag="{x:Static vm:BatchOperationKind.Crop}"
                      Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatchOpCrop]}" />
      </ComboBox>
    </DockPanel>

    <!-- File-list toolbar -->
    <DockPanel Grid.Row="1" Margin="0,0,0,4" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatchFilesLabel]}" />
      <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,2"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatchClear]}"
              Command="{Binding ClearFilesCommand}" />
      <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,2"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatchAdd]}"
              Click="OnAddFilesClick" />
      <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding FileCount, StringFormat={}{0} files}" />
    </DockPanel>

    <!-- File list with drag-drop -->
    <ListBox Grid.Row="2"
             ItemsSource="{Binding Files}"
             AllowDrop="True" DragOver="OnFilesDragOver" Drop="OnFilesDrop"
             Background="Transparent"
             Foreground="{DynamicResource Foreground}"
             BorderBrush="{DynamicResource Foreground}" BorderThickness="1">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Binding FileName}" FontWeight="Bold" />
              <TextBlock Text="{Binding SourcePath}" Opacity="0.6" FontSize="11" />
              <TextBlock Text="{Binding Error}"
                         Foreground="OrangeRed" FontSize="11"
                         TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                       Text="{Binding Outcome, FallbackValue=''}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Output folder -->
    <DockPanel Grid.Row="3" Margin="0,8,0,4" LastChildFill="True">
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatchOutputFolderLabel]}" />
      <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,2"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatchBrowse]}"
              Click="OnBrowseOutputClick" />
      <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
               VerticalContentAlignment="Center" />
    </DockPanel>

    <!-- Parallelism + progress -->
    <DockPanel Grid.Row="4" Margin="0,4,0,4" LastChildFill="True">
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatchParallelismLabel]}" />
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding MaxParallelism, StringFormat={}{0}}" />
      <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding CompletedCount, StringFormat=' {0}'}" />
      <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding TotalCount, StringFormat=' / {0}'}" />
      <Slider Margin="8,0,8,0" VerticalAlignment="Center"
              Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
              Value="{Binding MaxParallelism, Mode=TwoWay}" />
    </DockPanel>

    <!-- Run / Cancel -->
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Padding="12,4" Margin="0,0,8,0"
              IsDefault="True"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatchRun]}"
              Command="{Binding RunBatchCommand}" />
      <Button Padding="12,4"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatchCancel]}"
              Command="{Binding CancelBatchCommand}" />
      <Button Padding="12,4" Margin="8,0,0,0"
              IsCancel="True"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BatchClose]}"
              Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>

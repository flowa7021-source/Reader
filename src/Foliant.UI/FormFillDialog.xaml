<Window x:Class="Foliant.UI.FormFillDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[FormFillDialogTitle]}"
        Width="640"
        Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Margin="0,0,0,8"
               TextWrapping="Wrap"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding HeaderText}" />

    <DataGrid Grid.Row="1"
              ItemsSource="{Binding Fields}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              Background="Transparent"
              Foreground="{DynamicResource Foreground}"
              BorderBrush="{DynamicResource Foreground}"
              BorderThickness="1">
      <DataGrid.Columns>
        <DataGridTextColumn Width="2*"
                            IsReadOnly="True"
                            Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[FormFillColumnField]}"
                            Binding="{Binding Name}" />
        <DataGridTextColumn Width="3*"
                            Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[FormFillColumnValue]}"
                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button Width="140" Margin="0,0,8,0" Padding="8,2"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[FormFillSaveAs]}"
              IsEnabled="{Binding HasFields}"
              Click="OnSaveClick" />
      <Button Width="80"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DialogClose]}"
              IsCancel="True"
              Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>

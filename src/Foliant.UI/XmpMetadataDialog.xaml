<Window x:Class="Foliant.UI.XmpMetadataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[XmpDialogTitle]}"
        Width="680"
        Height="540"
        MinWidth="420"
        MinHeight="320"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Margin="0,0,0,6"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[XmpDialogHint]}" />

    <TextBox Grid.Row="1"
             Text="{Binding XmpText, UpdateSourceTrigger=PropertyChanged}"
             AcceptsReturn="True"
             AcceptsTab="True"
             TextWrapping="NoWrap"
             FontFamily="Consolas"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto" />

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[XmpSaveButton]}"
              Width="120" Margin="0,0,8,0"
              IsDefault="True"
              Click="OnSaveClick" />
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[XmpCancelButton]}"
              Width="80"
              IsCancel="True"
              Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>

<Window x:Class="Foliant.UI.SignaturesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SignaturesDialogTitle]}"
        Width="720"
        Height="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header / empty hint -->
    <TextBlock Grid.Row="0" Margin="0,0,0,8"
               TextWrapping="Wrap"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding HeaderText}" />

    <!-- Signature list -->
    <DataGrid Grid.Row="1"
              ItemsSource="{Binding Signatures}"
              SelectedItem="{Binding SelectedSignature, Mode=TwoWay}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              IsReadOnly="True"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              Background="Transparent"
              Foreground="{DynamicResource Foreground}"
              BorderBrush="{DynamicResource Foreground}"
              BorderThickness="1">
      <DataGrid.Columns>
        <DataGridTextColumn Width="*"
                            Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SignaturesColumnSigner]}"
                            Binding="{Binding SignerName}" />
        <DataGridTextColumn Width="160"
                            Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SignaturesColumnSignedAt]}"
                            Binding="{Binding SignedAtDisplay}" />
        <DataGridTextColumn Width="100"
                            Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SignaturesColumnKind]}"
                            Binding="{Binding KindDisplay}" />
        <DataGridTextColumn Width="160"
                            Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SignaturesColumnReason]}"
                            Binding="{Binding Reason}" />
      </DataGrid.Columns>
    </DataGrid>

    <!-- Validation result banner -->
    <TextBlock Grid.Row="2" Margin="0,8,0,0"
               TextWrapping="Wrap"
               Foreground="OrangeRed"
               Text="{Binding ValidationMessage}" />

    <!-- Buttons -->
    <StackPanel Grid.Row="3" Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button Width="120" Margin="0,0,8,0" Padding="8,2"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SignaturesValidate]}"
              IsEnabled="{Binding HasSelection}"
              Click="OnValidateClick" />
      <Button Width="80"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DialogClose]}"
              IsCancel="True"
              Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>

<Window x:Class="Foliant.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SettingsTitle]}"
        Width="440"
        Height="440"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Settings fields -->
    <StackPanel Grid.Row="0">
      <!-- Theme -->
      <StackPanel Orientation="Horizontal"
                  Margin="0,0,0,8">
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SettingsTheme]}"
                   Width="170"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Foreground}" />
        <ComboBox Width="210"
                  ItemsSource="{Binding AvailableThemes}"
                  SelectedItem="{Binding SelectedTheme}" />
      </StackPanel>

      <!-- Language -->
      <StackPanel Orientation="Horizontal"
                  Margin="0,0,0,8">
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SettingsLanguage]}"
                   Width="170"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Foreground}" />
        <ComboBox Width="210"
                  ItemsSource="{Binding AvailableLanguages}"
                  SelectedItem="{Binding SelectedLanguage}" />
      </StackPanel>

      <!-- OCR model tier -->
      <StackPanel Orientation="Horizontal"
                  Margin="0,0,0,8">
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SettingsOcrTier]}"
                   Width="170"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Foreground}" />
        <ComboBox Width="210"
                  ItemsSource="{Binding AvailableOcrTiers}"
                  SelectedItem="{Binding OcrModelTier}" />
      </StackPanel>

      <!-- Disk cache limit -->
      <StackPanel Orientation="Horizontal"
                  Margin="0,0,0,8">
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SettingsDiskCacheLimit]}"
                   Width="170"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Foreground}" />
        <TextBox Width="80"
                 Text="{Binding DiskCacheLimitGb, StringFormat='{}{0:F1}'}" />
      </StackPanel>

      <!-- Clear on exit -->
      <StackPanel Orientation="Horizontal"
                  Margin="0,0,0,8">
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SettingsClearCacheOnExit]}"
                   Width="170"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Foreground}" />
        <CheckBox IsChecked="{Binding ClearCacheOnExit}"
                  VerticalAlignment="Center" />
      </StackPanel>

      <!-- Check for updates (opt-out) -->
      <StackPanel Orientation="Horizontal"
                  Margin="0,0,0,8">
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SettingsCheckForUpdates]}"
                   Width="170"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Foreground}" />
        <CheckBox IsChecked="{Binding CheckForUpdates}"
                  VerticalAlignment="Center" />
      </StackPanel>

      <!-- Crash reporting (opt-in) -->
      <StackPanel Orientation="Horizontal"
                  Margin="0,0,0,8">
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SettingsCrashReporting]}"
                   Width="170"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Foreground}" />
        <CheckBox IsChecked="{Binding CrashReportingEnabled}"
                  VerticalAlignment="Center" />
      </StackPanel>

      <!-- Default annotation author (stamps Annotation.Author on creation; round-trips to PDF /T). -->
      <StackPanel Orientation="Horizontal"
                  Margin="0,0,0,8">
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SettingsDefaultAnnotationAuthor]}"
                   Width="170"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Foreground}" />
        <TextBox Width="200"
                 VerticalAlignment="Center"
                 Text="{Binding DefaultAnnotationAuthor, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>

      <!-- Right-to-left reading (Q-F3): swaps two-page spread order. -->
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SettingsRightToLeft]}"
                   Width="170"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Foreground}" />
        <CheckBox IsChecked="{Binding RightToLeft}"
                  VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <!-- OK / Cancel buttons -->
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DialogOk]}"
              Width="80"
              Margin="0,0,8,0"
              IsDefault="True"
              Click="OnOkClick" />
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DialogCancel]}"
              Width="80"
              IsCancel="True"
              Click="OnCancelClick" />
    </StackPanel>
  </Grid>

</Window>

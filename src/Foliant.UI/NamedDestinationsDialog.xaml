<Window x:Class="Foliant.UI.NamedDestinationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[NamedDestDialogTitle]}"
        SizeToContent="Height"
        Width="540"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="EmptyLabel" Grid.Row="0" Margin="0,0,0,4"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[NamedDestEmpty]}" />

    <Border Grid.Row="1" Margin="0,0,0,8" BorderBrush="{DynamicResource Foreground}" BorderThickness="1">
      <ListBox x:Name="DestList" Height="150" Background="Transparent"
               Foreground="{DynamicResource Foreground}"
               ItemsSource="{Binding Rows}"
               SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Margin="2" Foreground="{DynamicResource Foreground}" Text="{Binding Display}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[NamedDestNameLabel]}" />
      <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,4" Padding="4"
               Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                 Foreground="{DynamicResource Foreground}"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[NamedDestPageLabel]}" />
      <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="4"
               Text="{Binding PageText, UpdateSourceTrigger=PropertyChanged}" />

      <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3"
              Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[NamedDestAddButton]}"
              Click="OnAddClick" />
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[NamedDestRemoveButton]}"
              Width="130" Margin="0,0,8,0"
              Click="OnRemoveClick" />
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[NamedDestCloseButton]}"
              Width="80"
              IsCancel="True"
              Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>

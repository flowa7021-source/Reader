<Window x:Class="Foliant.UI.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding DialogTitle}"
        SizeToContent="Height"
        Width="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Margin="0,0,0,8"
               Foreground="{DynamicResource Foreground}"
               TextWrapping="Wrap"
               Text="{Binding Label}" />

    <TextBox x:Name="InputTextBox"
             Grid.Row="1"
             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
             FontSize="14"
             Padding="4"
             KeyDown="OnTextBoxKeyDown" />

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DialogOk]}"
              Width="80"
              Margin="0,0,8,0"
              IsDefault="True"
              Click="OnOkClick" />
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DialogCancel]}"
              Width="80"
              IsCancel="True"
              Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>

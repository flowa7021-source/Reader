<Window x:Class="Foliant.UI.AttachmentsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Foliant.UI.Localization"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AttachmentsDialogTitle]}"
        SizeToContent="Height"
        Width="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="EmptyLabel" Grid.Row="0" Margin="0,0,0,4"
               Foreground="{DynamicResource Foreground}"
               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AttachmentsEmpty]}" />

    <Border Grid.Row="1" BorderBrush="{DynamicResource Foreground}" BorderThickness="1">
      <ListBox x:Name="AttachmentsList"
               Height="220"
               Background="Transparent"
               Foreground="{DynamicResource Foreground}"
               ItemsSource="{Binding Items}"
               SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Margin="2" Foreground="{DynamicResource Foreground}" Text="{Binding Display}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AttachmentsAddButton]}"
              Width="100" Margin="0,0,8,0"
              Click="OnAddClick" />
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AttachmentsExtractButton]}"
              Width="100" Margin="0,0,8,0"
              Click="OnExtractClick" />
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AttachmentsRemoveButton]}"
              Width="100" Margin="0,0,8,0"
              Click="OnRemoveClick" />
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AttachmentsCloseButton]}"
              Width="80"
              IsCancel="True"
              Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>

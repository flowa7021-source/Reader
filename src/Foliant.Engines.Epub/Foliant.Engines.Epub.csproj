<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Foliant.Engines.Epub</RootNamespace>
    <Description>EPUB engine. EPUB 2/3 via VersOne.Epub (pure managed, cross-platform). Chapters are laid out and painted to real BGRA32 pages via Foliant.Rendering.Html (AngleSharp + SixLabors), with fixed-reference, scale-invariant pagination so each chapter spans one or more fixed-height page slices. Text layer carries chapter content stripped to plain text for search/FTS.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VersOne.Epub" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foliant.Domain\Foliant.Domain.csproj" />
    <ProjectReference Include="..\Foliant.Rendering.Html\Foliant.Rendering.Html.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Foliant.Engines.Epub.Tests" />
  </ItemGroup>

</Project>

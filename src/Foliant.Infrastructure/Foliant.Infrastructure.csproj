<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target: net10.0 lets the cross-platform layer (cache/search/settings/eventstore)
         build and unit-test on Linux; net10.0-windows carries the Windows-only DPAPI/registry
         licensing + trial storage (built on Windows CI). -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <RootNamespace>Foliant.Infrastructure</RootNamespace>
    <Description>
      Кэш (5 слоёв), Serilog, Settings, EventStore, FileFingerprint, SqliteIndex,
      ProcessRunner для out-of-process плагинов.
    </Description>
  </PropertyGroup>

  <!-- DPAPI + HKCU registry storage is Windows-only; excluded from the net10.0 build. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Licensing/DpapiLicenseStorage.cs" />
    <Compile Remove="Storage/TrialStores.cs" />
    <Compile Remove="Storage/TrialPersistenceService.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <!-- MEF2 host для обнаружения engine-плагинов ([Export(typeof(IEnginePlugin))]). -->
    <PackageReference Include="System.Composition" />
    <!-- System.Text.Json — часть .NET 10 runtime, не нужен явно. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foliant.Application\Foliant.Application.csproj" />
    <ProjectReference Include="..\Foliant.Domain\Foliant.Domain.csproj" />
    <ProjectReference Include="..\Foliant.Plugins.Contracts\Foliant.Plugins.Contracts.csproj" />
  </ItemGroup>

</Project>

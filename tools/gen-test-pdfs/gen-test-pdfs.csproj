<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Foliant.Tools.GenTestPdfs</RootNamespace>
    <AssemblyName>gen-test-pdfs</AssemblyName>
    <Description>Генерирует детерминированные синтетические/битые PDF-ассеты в tests/assets для золотого набора.</Description>
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" />
  </ItemGroup>

  <!-- DejaVuSans (Bitstream Vera license, free to redistribute) is embedded so the
       Cyrillic test PDF renders deterministically without depending on host fonts. -->
  <ItemGroup>
    <EmbeddedResource Include="DejaVuSans.ttf" />
  </ItemGroup>

</Project>

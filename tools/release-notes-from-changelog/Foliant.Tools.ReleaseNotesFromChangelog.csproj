<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Foliant.Tools.ReleaseNotesFromChangelog</RootNamespace>
    <AssemblyName>release-notes-from-changelog</AssemblyName>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The test project lives under tests/; keep its sources out of this Exe's default glob. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ChangelogSlicer.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
